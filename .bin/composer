#!/bin/sh

user="-u $(id -u):$(id -g) "

for arg in "$@"; do
    case $arg in
        "--int") interactive="-it ";;
        "--root") user="";;
        *) command="$command $arg";;
    esac
done

docker run --rm $interactive$user-P -v .:$PWD -w $PWD -e SHELL=/bin/sh composer_local:1.0 composer$command

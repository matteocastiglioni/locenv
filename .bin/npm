#!/bin/sh

# detect if in interactive shell
[ -t 0 ] && interactive="-it "

user="-u $(id -u):$(id -g) "

while [ $# -gt 0 ]
do
    case $1 in
        -i|--int) interactive="-it " ;;
        -r|--root) user="" ;;
        -p|--port)
            port="-p $2:$2 "
            shift
            ;;
        *) args="$args $1" ;;
    esac

    shift
done

docker run --rm $interactive$user$port-P -v .:$PWD -w $PWD -e SHELL=/bin/sh node_local:1.0 npm$args
